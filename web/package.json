{
  "name": "dev-van-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:sim": "esbuild test/sim.smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim.smoke.mjs --log-level=warning && node node_modules/.cache/sim.smoke.mjs",
    "test:rig": "esbuild test/rig.smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rig.smoke.mjs --log-level=warning && node node_modules/.cache/rig.smoke.mjs",
    "test": "npm run typecheck && npm run test:sim && npm run test:rig && npm run test:textures",
    "test:textures": "esbuild test/textures.smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/textures.smoke.mjs --log-level=warning && node node_modules/.cache/textures.smoke.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "esbuild": "^0.24.0"
  }
}
