# ── DEV VAN LIFE — environment ────────────────────────────────────────────────
# Copy to .env (docker run --env-file .env ...) or set as service variables.

# Global default Gemini key. Optional: the app runs in DEMO MODE with canned
# agent lines when this is empty, so you can test the full flow for $0.
GEMINI_API_KEY=

# Gemini model used for every call (manager planning, staff work, meetings).
GEMINI_MODEL=gemini-2.5-flash

# Listen port (Railway/Render set this for you; default 8080).
PORT=8080

# Length of one full day/night cycle in minutes.
DAY_CYCLE_MINUTES=12

# Hard cap of Gemini calls per "Discuss with Team" session.
MEETING_CALL_CAP=20

# Where store.json lives. Mount your volume at this path.
# In the Docker image this defaults to /app/data.
DATA_DIR=./data
